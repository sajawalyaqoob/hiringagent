# ==============================================================================
# HireBoost AI — Production Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit production secrets to version control.
# Never expose server secrets through NEXT_PUBLIC_* variables.
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="HireBoost AI"

# Database & Authentication (Supabase PostgreSQL)
# Public variables accessible in browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SERVER-ONLY SECRET (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Providers (SERVER-ONLY SECRETS)
# Priority: 1. GROQ_API_KEY (fastest/free), 2. GEMINI_API_KEY (free 1M ctx), 3. OPENAI_API_KEY, 4. Dev Mock
GROQ_API_KEY=gsk_your_groq_api_key
GEMINI_API_KEY=your_google_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Media & Image Storage (Cloudinary - for profile pictures & avatars)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Job Search Data Provider (SERVER-ONLY SECRET)
# Used by JobDiscoveryService for live job search normalization (e.g. JSearch / Arbeitnow API)
JOB_API_KEY=your_job_search_api_key

# Email Delivery Service (SERVER-ONLY SECRET - Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="HireBoost AI <notifications@hireboost.ai>"

# Payments & Subscriptions (Stripe Integration)
# Public publishable key accessible in browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# SERVER-ONLY SECRETS
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
